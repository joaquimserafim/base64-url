{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["**", "!**/dist", "!**/node_modules", "!**/coverage"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": { "noExplicitAny": "error" },
			"style": { "useImportType": "warn", "noNonNullAssertion": "warn" }
		}
	},
	"overrides": [
		{
			"includes": ["src/index.ts", "test/index.test.ts"],
			"linter": {
				"rules": {
					"suspicious": { "noShadowRestrictedNames": "off" }
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "es5"
		}
	}
}
