{
  "name": "base64-url",
  "version": "2.3.3",
  "description": "Base64 encode, decode, escape and unescape for URL applications",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.js",
    "index.cjs",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node test.js && node test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/joaquimserafim/base64-url.git"
  },
  "keywords": [
    "base64",
    "base64url",
    "esm"
  ],
  "author": "@joaquimserafim",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/joaquimserafim/base64-url/issues"
  },
  "homepage": "https://github.com/joaquimserafim/base64-url",
  "devDependencies": {
    "coveralls": "^3.0.0",
    "nyc": "^14.1.1",
    "pre-commit": "^1.2.2",
    "standard": "^10.0.3",
    "tape": "^4.8.0"
  },
  "pre-commit": [
    "test"
  ],
  "engines": {
    "node": ">=12"
  }
}
